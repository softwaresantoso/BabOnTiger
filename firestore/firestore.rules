rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasBusiness(businessId) {
      return signedIn() && userDoc().businessId == businessId;
    }

    function role(roleName) {
      return signedIn() && userDoc().role == roleName;
    }

    function staff(businessId) {
      return hasBusiness(businessId) && (role("owner") || role("barber"));
    }

    match /users/{uid} {
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.role == "customer";
      allow read: if signedIn() && (uid == request.auth.uid || role("owner"));
      allow update: if signedIn() && (uid == request.auth.uid && resource.data.role == "customer")
        || role("owner");
      allow delete: if role("owner");
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow write: if role("owner") && hasBusiness(businessId);

      match /branches/{branchId} {
        allow read: if true;
        allow create, update, delete: if role("owner") && hasBusiness(businessId);
      }

      match /services/{serviceId} {
        allow read: if resource.data.active == true || staff(businessId);
        allow create, update, delete: if role("owner") && hasBusiness(businessId);
      }

      match /barbers/{barberId} {
        allow read: if resource.data.active == true || staff(businessId);
        allow create, update, delete: if role("owner") && hasBusiness(businessId);
      }

      match /schedules/{scheduleId} {
        allow read: if true;
        allow create, update, delete: if role("owner") && hasBusiness(businessId);
      }

      match /specialSchedules/{scheduleId} {
        allow read: if true;
        allow create, update, delete: if role("owner") && hasBusiness(businessId);
      }

      match /bookings/{bookingId} {
        allow read: if staff(businessId)
          || (signedIn() && resource.data.customerId == request.auth.uid);

        allow create: if signedIn()
          && hasBusiness(businessId)
          && request.resource.data.businessId == businessId
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.status == "PENDING";

        allow update: if staff(businessId)
          || (signedIn()
            && resource.data.customerId == request.auth.uid
            && request.resource.data.customerId == resource.data.customerId
            && request.resource.data.status == "CANCELLED");

        allow delete: if role("owner") && hasBusiness(businessId);
      }

      match /bookingLocks/{lockId} {
        allow read: if true;
        allow create: if signedIn()
          && hasBusiness(businessId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.businessId == businessId;
        allow delete: if staff(businessId)
          || (signedIn() && resource.data.ownerUid == request.auth.uid);
        allow update: if false;
      }

      match /transactions/{transactionId} {
        allow read: if staff(businessId);
        allow create, update, delete: if role("owner") && hasBusiness(businessId);
      }
    }
  }
}
