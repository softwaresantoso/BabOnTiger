rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // BASIC AUTH HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function activeUser() {
      return signedIn()
        && userData().active != false;
    }

    function isOwner() {
      return activeUser()
        && userData().role in ["owner", "admin"];
    }

    function isBarber() {
      return activeUser()
        && userData().role == "barber";
    }

    function isCustomer() {
      return activeUser()
        && userData().role == "customer";
    }

    function sameBusiness(businessId) {
      return activeUser()
        && userData().businessId == businessId;
    }

    function ownerOf(businessId) {
      return sameBusiness(businessId)
        && isOwner();
    }

    function barberOfBranch(businessId, branchId) {
      return sameBusiness(businessId)
        && isBarber()
        && userData().branchId == branchId
        && userData().barberId != null;
    }

    function staff(businessId) {
      return ownerOf(businessId)
        || (
          isBarber()
          && sameBusiness(businessId)
        );
    }

    function staffOfBranch(businessId, branchId) {
      return ownerOf(businessId)
        || barberOfBranch(businessId, branchId);
    }

    function ownsUser(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }


    // =========================================================
    // EXISTENCE / VALIDATION HELPERS
    // =========================================================

    function branchExists(businessId, branchId) {
      return exists(
        /databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)
      );
    }

    function branchBelongs(businessId, branchId) {
      return branchExists(businessId, branchId)
        && get(
          /databases/$(database)/documents/businesses/$(businessId)/branches/$(branchId)
        ).data.businessId == businessId;
    }

    function barberExists(businessId, barberId) {
      return exists(
        /databases/$(database)/documents/businesses/$(businessId)/barbers/$(barberId)
      );
    }

    function serviceExists(businessId, serviceId) {
      return exists(
        /databases/$(database)/documents/businesses/$(businessId)/services/$(serviceId)
      );
    }

    function productExists(businessId, productId) {
      return exists(
        /databases/$(database)/documents/businesses/$(businessId)/products/$(productId)
      );
    }

    function publicActive() {
      return resource.data.active == true;
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {

      allow create: if ownsUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == "customer"
        && request.resource.data.active != false;

      allow get, list: if ownsUser(uid)
        || (
          ownerOf(resource.data.businessId)
          && resource.data.businessId == userData().businessId
        );

      allow update: if (
          ownsUser(uid)
          && resource.data.role == "customer"
          && resource.data.businessId == request.resource.data.businessId
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "phone",
            "active",
            "updatedAt"
          ])
        ) || (
          ownerOf(resource.data.businessId)
          && resource.data.businessId == userData().businessId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.role in ["customer", "barber"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "phone",
            "role",
            "branchId",
            "barberId",
            "active",
            "updatedAt"
          ])
        );

      allow delete: if ownerOf(resource.data.businessId)
        && resource.data.businessId == userData().businessId;
    }


    // =========================================================
    // BUSINESS
    // =========================================================

    match /businesses/{businessId} {

      allow get: if resource.data.active == true
        || ownerOf(businessId);

      allow list: if false;

      allow create: if isOwner()
        && request.resource.data.id == businessId;

      allow update: if ownerOf(businessId)
        && request.resource.data.id == resource.data.id;

      allow delete: if false;


      // =======================================================
      // BRANCHES
      // =======================================================

      match /branches/{branchId} {

        allow get, list: if publicActive()
          || staffOfBranch(businessId, branchId);

        allow create, update, delete: if ownerOf(businessId)
          && request.resource.data.businessId == businessId;
      }


      // =======================================================
      // BARBERS
      // =======================================================

      match /barbers/{barberId} {

        allow get, list: if publicActive()
          || staffOfBranch(
            businessId,
            resource.data.branchId
          );

        allow create: if ownerOf(businessId)
          && request.resource.data.businessId == businessId;

        allow update: if ownerOf(businessId)
          && request.resource.data.businessId == resource.data.businessId;

        allow delete: if ownerOf(businessId);
      }


      // =======================================================
      // SERVICES
      // =======================================================

      match /services/{serviceId} {

        allow get, list: if publicActive()
          || staffOfBranch(
            businessId,
            resource.data.branchId
          );

        allow create: if ownerOf(businessId)
          && request.resource.data.businessId == businessId;

        allow update: if ownerOf(businessId)
          && request.resource.data.businessId == resource.data.businessId;

        allow delete: if ownerOf(businessId);
      }


      // =======================================================
      // PRODUCTS
      // =======================================================

      match /products/{productId} {

        allow get, list: if publicActive()
          || staffOfBranch(
            businessId,
            resource.data.branchId
          );

        allow create: if ownerOf(businessId)
          && request.resource.data.businessId == businessId
          && branchBelongs(
            businessId,
            request.resource.data.branchId
          );

        allow update: if ownerOf(businessId)
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.branchId == resource.data.branchId;

        allow delete: if ownerOf(businessId);
      }


      // =======================================================
      // PROMOS
      // =======================================================

      match /promos/{promoId} {

        allow get, list: if publicActive()
          || sameBusiness(businessId);

        allow create: if ownerOf(businessId)
          && request.resource.data.businessId == businessId;

        allow update: if ownerOf(businessId)
          && request.resource.data.businessId == resource.data.businessId;

        allow delete: if ownerOf(businessId);
      }


      // =======================================================
      // SCHEDULES
      // =======================================================

      match /schedules/{scheduleId} {

        allow get, list: if true;

        allow create: if ownerOf(businessId)
          && (
            !('branchId' in request.resource.data)
            || request.resource.data.branchId == null
            || branchBelongs(
              businessId,
              request.resource.data.branchId
            )
          );

        allow update: if ownerOf(businessId);

        allow delete: if ownerOf(businessId);
      }


      // =======================================================
      // SPECIAL SCHEDULES
      // =======================================================

      match /specialSchedules/{scheduleId} {

        allow get, list: if true;

        allow create, update, delete: if ownerOf(businessId);
      }


      // =======================================================
      // BOOKINGS
      // =======================================================

      match /bookings/{bookingId} {

        allow read: if staff(businessId)
          || (
            signedIn()
            && resource.data.customerId == request.auth.uid
          );

        allow create: if signedIn()
          && request.resource.data.businessId == businessId
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.status == "PENDING"
          && branchBelongs(
            businessId,
            request.resource.data.branchId
          );

        allow update: if staff(businessId)
          || (
            signedIn()
            && resource.data.customerId == request.auth.uid
            && request.resource.data.customerId == resource.data.customerId
            && request.resource.data.status == "CANCELLED"
          );

        allow delete: if isOwner()
          && sameBusiness(businessId);
      }


      // =======================================================
      // QUEUE COUNTERS
      // =======================================================
      //
      // createQueueEntry() menggunakan runTransaction():
      //
      // 1. tx.get(counterRef)
      // 2. tx.set(counterRef, ...)
      // 3. tx.set(queueRef, ...)
      //
      // Karena customer melakukan booking online, customer harus
      // dapat membaca counter dan membuat/memperbarui counter
      // untuk branch yang valid.
      //
      // =======================================================

      match /queueCounters/{counterId} {

        // Dibutuhkan oleh tx.get(counterRef).
        // Counter hanya boleh dibaca untuk branch yang valid.
        allow get: if signedIn()
          && branchBelongs(
            businessId,
            resource.data.branchId
          );

        allow list: if false;

        // Counter pertama kali dibuat oleh booking online
        // atau walk-in staff.
        allow create: if (
            signedIn()
            && request.resource.data.businessId == businessId
            && branchBelongs(
              businessId,
              request.resource.data.branchId
            )
            && request.resource.data.nextNumber >= 2
          );

        // Counter berikutnya dinaikkan satu per transaksi queue.
        allow update: if (
            signedIn()
            && request.resource.data.businessId == resource.data.businessId
            && request.resource.data.branchId == resource.data.branchId
            && request.resource.data.date == resource.data.date
            && request.resource.data.nextNumber == resource.data.nextNumber + 1
            && branchBelongs(
              businessId,
              request.resource.data.branchId
            )
          );

        allow delete: if ownerOf(businessId);
      }


      // =======================================================
      // QUEUES
      // =======================================================

      match /queues/{queueId} {

        // Queue dapat dibaca publik.
        allow read: if true;

        // Staff dapat membuat queue.
        //
        // Customer dapat membuat queue miliknya sendiri.
        // Booking ID divalidasi agar queue tidak dapat dibuat
        // menggunakan booking milik customer lain.
        allow create: if (
            staff(businessId)
            && request.resource.data.businessId == businessId
            && branchBelongs(
              businessId,
              request.resource.data.branchId
            )
          ) || (
            signedIn()
            && request.resource.data.businessId == businessId
            && request.resource.data.customerId == request.auth.uid
            && request.resource.data.source == "ONLINE"
            && request.resource.data.status == "BOOKED"
            && request.resource.data.bookingId != null
            && get(
              /databases/$(database)/documents/businesses/$(businessId)/bookings/$(request.resource.data.bookingId)
            ).data.customerId == request.auth.uid
            && get(
              /databases/$(database)/documents/businesses/$(businessId)/bookings/$(request.resource.data.bookingId)
            ).data.branchId == request.resource.data.branchId
            && branchBelongs(
              businessId,
              request.resource.data.branchId
            )
          );

        // Staff dapat mengubah queue.
        // Customer hanya dapat mengubah queue miliknya sendiri.
        allow update: if staff(businessId)
          || (
            signedIn()
            && resource.data.customerId == request.auth.uid
            && request.resource.data.customerId == resource.data.customerId
            && request.resource.data.businessId == resource.data.businessId
          );

        allow delete: if staff(businessId);
      }


      // =======================================================
      // ATTENDANCE
      // =======================================================

      match /attendance/{attendanceId} {

        allow get, list: if sameBusiness(businessId)
          && (
            isOwner()
            || (
              isBarber()
              && resource.data.branchId == userData().branchId
            )
          );

        allow create: if (
            ownerOf(businessId)
            && request.resource.data.businessId == businessId
            && branchBelongs(
              businessId,
              request.resource.data.branchId
            )
            && barberExists(
              businessId,
              request.resource.data.barberId
            )
          ) || (
            isBarber()
            && sameBusiness(businessId)
            && request.resource.data.businessId == businessId
            && request.resource.data.branchId == userData().branchId
            && request.resource.data.barberId == userData().barberId
          );

        allow update: if ownerOf(businessId)
          || (
            isBarber()
            && sameBusiness(businessId)
            && resource.data.branchId == userData().branchId
            && resource.data.barberId == userData().barberId
            && request.resource.data.businessId == resource.data.businessId
            && request.resource.data.branchId == resource.data.branchId
            && request.resource.data.barberId == resource.data.barberId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "checkInAt",
              "checkOutAt",
              "checkInMethod",
              "updatedAt"
            ])
          );

        allow delete: if ownerOf(businessId);
      }


      // =======================================================
      // TRANSACTIONS
      // =======================================================

      match /transactions/{transactionId} {

        allow get, list: if sameBusiness(businessId)
          && (
            isOwner()
            || (
              isBarber()
              && resource.data.branchId == userData().branchId
            )
            || (
              isCustomer()
              && resource.data.customerId == request.auth.uid
            )
          );

        allow create: if staffOfBranch(
            businessId,
            request.resource.data.branchId
          )
          && request.resource.data.businessId == businessId
          && request.resource.data.createdBy == request.auth.uid
          && (
            !isBarber()
            || !('barberId' in request.resource.data)
            || request.resource.data.barberId == null
            || request.resource.data.barberId == userData().barberId
          );

        allow update: if ownerOf(businessId)
          || (
            isBarber()
            && sameBusiness(businessId)
            && resource.data.branchId == userData().branchId
            && request.resource.data.businessId == resource.data.businessId
            && request.resource.data.branchId == resource.data.branchId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.barberId == resource.data.barberId
          );

        allow delete: if ownerOf(businessId);
      }


      // =======================================================
      // STOCK MOVEMENTS
      // =======================================================

      match /stockMovements/{movementId} {

        allow get, list: if staffOfBranch(
          businessId,
          resource.data.branchId
        );

        allow create: if staffOfBranch(
            businessId,
            request.resource.data.branchId
          )
          && request.resource.data.businessId == businessId
          && request.resource.data.createdBy == request.auth.uid
          && productExists(
            businessId,
            request.resource.data.productId
          )
          && get(
            /databases/$(database)/documents/businesses/$(businessId)/products/$(request.resource.data.productId)
          ).data.branchId == request.resource.data.branchId;

        allow update: if ownerOf(businessId)
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.branchId == resource.data.branchId;

        allow delete: if ownerOf(businessId);
      }


      // =======================================================
      // PROMO USAGES
      // =======================================================

      match /promoUsages/{usageId} {

        allow get, list: if sameBusiness(businessId)
          && (
            isOwner()
            || (
              isBarber()
              && resource.data.branchId == userData().branchId
            )
            || (
              isCustomer()
              && resource.data.customerId == request.auth.uid
            )
          );

        allow create: if staffOfBranch(
            businessId,
            request.resource.data.branchId
          )
          && request.resource.data.businessId == businessId;

        allow update: if ownerOf(businessId)
          || (
            isBarber()
            && sameBusiness(businessId)
            && resource.data.branchId == userData().branchId
            && request.resource.data.businessId == resource.data.businessId
            && request.resource.data.branchId == resource.data.branchId
          );

        allow delete: if ownerOf(businessId);
      }


      // =======================================================
      // BOOKING LOCKS
      // =======================================================

      match /bookingLocks/{lockId} {

        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.businessId == businessId
          && request.resource.data.ownerUid == request.auth.uid;

        allow delete: if staff(businessId)
          || (
            signedIn()
            && resource.data.ownerUid == request.auth.uid
          );

        allow update: if false;
      }


      // =======================================================
      // SETTINGS
      // =======================================================

      match /settings/{settingId} {

        allow get, list: if ownerOf(businessId);

        allow create, update, delete: if ownerOf(businessId);
      }
    }
  }
}