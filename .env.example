VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Tenant / business configuration
VITE_BUSINESS_ID=your-business-id
VITE_BUSINESS_NAME=Nama Barber Shop
VITE_TIMEZONE=Asia/Jakarta

# Cloudinary unsigned upload foundation
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Only for npm run seed (never expose these as VITE_ variables):
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
